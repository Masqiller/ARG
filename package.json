{
  "name": "awwesome-ruflo-graphify",
  "version": "1.1.0",
  "description": "ARG — Autonomous intelligence layer with knowledge-graph-driven context pruning, skill routing, and MCP server integration.",
  "main": "dist/mcp-server.js",
  "bin": {
    "arg-mcp": "bin/arg-mcp.js"
  },
  "files": [
    "dist/",
    "bin/",
    "scripts/arg_skill_server.py",
    "scripts/arg_import_skills_to_db.py",
    "init.sh",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "chmod +x init.sh && ./init.sh",
    "vibe": "npx ts-node src/vibe-router.ts",
    "graph": "graphify build .",
    "mcp": "node dist/mcp-server.js"
  },
  "keywords": [
    "ruflo",
    "graphify",
    "mcp",
    "knowledge-graph",
    "ai-agent",
    "swarm"
  ],
  "author": "Smit",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "codeburn": "latest",
    "dotenv": "^16.4.5",
    "n8n-mcp": "^2.50.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
