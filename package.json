{
  "name": "awwesome-ruflo-graphify",
  "version": "1.0.0",
  "description": "ARG — Autonomous intelligence layer with knowledge-graph-driven context pruning, skill routing, and MCP server integration.",
  "main": "dist/mcp-server.js",
  "bin": {
    "arg-mcp": "bin/arg-mcp.js"
  },
  "files": [
    "dist/",
    "bin/",
    "scripts/arg_skill_server.py",
    "scripts/arg_import_skills_to_db.py",
    "init.sh",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "setup": "chmod +x init.sh && ./init.sh",
    "vibe": "npx ts-node src/vibe-router.ts",
    "graph": "graphify build .",
    "remember": "node vendor/claude-mem/dist/cli/index.js remember",
    "mcp": "node dist/mcp-server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ruflo",
    "graphify",
    "mcp",
    "knowledge-graph",
    "ai-agent",
    "swarm"
  ],
  "author": "Smit",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "codeburn": "latest",
    "dotenv": "^16.4.5",
    "n8n-mcp": "^2.50.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
